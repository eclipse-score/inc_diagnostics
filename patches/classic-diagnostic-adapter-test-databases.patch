#
# Rationale: The CDA repository keeps the ECU databases (MDD) of its ECU simulator in
# testcontainer/odx but has no Bazel package for them. This patch exposes them as a filegroup so
# that an image can ship the databases that the simulator's ECUs match.
#
diff --git a/testcontainer/odx/BUILD.bazel b/testcontainer/odx/BUILD.bazel
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/testcontainer/odx/BUILD.bazel
@@ -0,0 +1,5 @@
+filegroup(
+    name = "mdd",
+    srcs = glob(["*.mdd"]),
+    visibility = ["//visibility:public"],
+)
