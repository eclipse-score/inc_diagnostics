#
# Rationale: Expose additional crate_index dependencies from opensovd-core that
# are needed by the score diagnostics gateway. tokio and async-trait are needed
# for the bridge layer; axum for the CDA reverse proxy; serde_json and tracing
# for logging and serialisation.
#
diff --git a/BUILD.bazel b/BUILD.bazel
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -38,6 +38,36 @@
     actual = "//opensovd-server:opensovd_server",
 )
 
+alias(
+    name = "tokio",
+    actual = "@crate_index//:tokio",
+)
+
+alias(
+    name = "tracing",
+    actual = "@crate_index//:tracing",
+)
+
+alias(
+    name = "tracing-subscriber",
+    actual = "@crate_index//:tracing-subscriber",
+)
+
+alias(
+    name = "async-trait",
+    actual = "@crate_index//:async-trait",
+)
+
+alias(
+    name = "serde_json",
+    actual = "@crate_index//:serde_json",
+)
+
+alias(
+    name = "axum",
+    actual = "@crate_index//:axum",
+)
+
 alias(
     name = "opensovd-mocks",
     actual = "//opensovd-mocks:opensovd_mocks",
