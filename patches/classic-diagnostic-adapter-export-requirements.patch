#
# Rationale: exposes the CDA requirement sources and their Sphinx configuration so
# that //score/opensovd-cda:needs_json can build the CDA requirements at the pinned
# commit and the component requirements can reference them directly.
#
diff --git a/BUILD.bazel b/BUILD.bazel
index 734a77d..35c02bf 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -132,3 +132,9 @@ alias(
     actual = "//cda-main:opensovd-cda",
     visibility = ["//visibility:public"],
 )
+
+filegroup(
+    name = "requirements_docs",
+    srcs = ["docs/conf.py"] + glob(["docs/02_requirements/*.rst"]),
+    visibility = ["//visibility:public"],
+)
