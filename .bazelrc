common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build
# Keep independent module-extension usages from merging their configuration tags.
common --experimental_isolated_extension_usages

build --java_language_version=17
build --tool_java_language_version=17
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17

test --build_tests_only
test --test_output=errors
test --test_tag_filters=-manual

build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Use the GCC C++ toolchain for x86-64 linux host by default for `bazel run`
run --host_platform=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
run --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0

# Basic build settings
# C++17 is required for SOVD bridge integration. This is configured via cxxopt rather than
# toolchain features to avoid conflicts with Rust compilation targets that share the same
# toolchain configuration. Toolchain feature-based configuration would require separate
# toolchain definitions for C++ and Rust targets, adding unnecessary complexity.
build:_score_diag_common_build_settings --cxxopt=-std=c++17
build:_score_diag_common_build_settings --features=minimal_warnings
build:_score_diag_common_build_settings --features=strict_warnings
# Enforce warning errors for main-repository sources only. The regex is matched against labels;
# the ^ anchor matters: labels in external repositories start with @ (e.g. @score_baselibs+//...),
# so ^//.* matches only targets of this repository and external repositories keep their own flags.
# Without the anchor, //.* would also match inside external labels. Code vendored into this repository
# is not excluded. The host variant covers main-repository tools built for the exec configuration.
# CI checks with bazel aquery that -Werror reaches main-repository compile actions and no external
# ones (see build_linux.yml).
build:_score_diag_common_build_settings --per_file_copt=^//.*@-Werror
build:_score_diag_common_build_settings --host_per_file_copt=^//.*@-Werror
build:_score_diag_common_build_settings --incompatible_strict_action_env

# Base configuration for building on x86-64 linux host.
# Use hermetic GCC toolchain with Ferrocene Rust for both host and target.
# The gcc toolchain is required for native C/C++ dependencies (mbedtls, etc.).
# The ferrocene toolchain is the qualified Rust compiler for safety-critical builds.
# rules_foreign_cc 0.17.0+ uses pkgconf instead of pkg-config, eliminating the
# BootstrapPkgConfig glib build that previously required auto-detected host toolchain.
common:_score_diag_use_gcc_based_host_platform --host_platform=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
common:_score_diag_use_gcc_based_host_platform --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
common:_score_diag_use_gcc_based_host_platform --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu

# Base configuration for compiling for x86-64 linux as target platform
# Same toolchains as host for this configuration since we're building on the target platform.
common:_score_diag_build_for_x86_64_linux_target_platform --platforms=@score_bazel_platforms//:x86_64-linux-gcc_12.2.0-posix
common:_score_diag_build_for_x86_64_linux_target_platform --extra_toolchains=@score_gcc_x86_64_toolchain//:x86_64-linux-gcc_12.2.0
common:_score_diag_build_for_x86_64_linux_target_platform --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu

# Configuration for x86_64 Linux builds
common:score_diag_x86_64_linux --config=_score_diag_common_build_settings
common:score_diag_x86_64_linux --config=_score_diag_use_gcc_based_host_platform
common:score_diag_x86_64_linux --config=_score_diag_build_for_x86_64_linux_target_platform

# Import custom user settings
# Can be used to e.g. enable custom features without modifying this main .bazelrc
try-import %workspace%/user.bazelrc
